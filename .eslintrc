{
  "root": true,
  "ignorePatterns": ["projects/**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": ["tsconfig.json", "e2e/tsconfig.json"],
        "createDefaultProgram": true
      },
      "extends": ["plugin:prettier/recommended", "plugin:@angular-eslint/template/process-inline-templates"]
    },
    {
      "files": ["experiments/browser-prf/probe.js"],
      "env": {"browser": true, "es2022": true},
      "extends": ["eslint:recommended"],
      "parserOptions": {"ecmaVersion": 2022}
    },
    {
      "files": ["tests/*.cjs"],
      "env": {
        "node": true,
        "es2022": true
      },
      "extends": ["eslint:recommended"],
      "parserOptions": {
        "ecmaVersion": 2022
      }
    },
    {
      "files": ["**/mobile-menu.component.html", "**/account-dropdown.component.html", "**/start.component.html", "**/send-button.component.html", "**/404.component.html", "**/500.component.html"],
      "parser": "@angular-eslint/template-parser",
      "plugins": ["@angular-eslint/template"],
      "rules": {
        "@angular-eslint/template/click-events-have-key-events": "error",
        "@angular-eslint/template/accessibility-interactive-supports-focus": "error",
        "@angular-eslint/template/accessibility-alt-text": "error"
      }
    }
  ]
}
